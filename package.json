{
  "name": "dose-dossier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dose Dossier: a daily guess-the-drug game built from public FDA labels.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "fetch-label": "NODE_USE_ENV_PROXY=1 node tools/fetch-label.mjs",
    "fetch-structure": "NODE_USE_ENV_PROXY=1 node tools/fetch-structure.mjs",
    "resolve": "NODE_USE_ENV_PROXY=1 node tools/resolve.mjs",
    "digest": "node tools/digest.mjs",
    "structures": "NODE_USE_ENV_PROXY=1 node tools/structures.mjs",
    "verify": "node tools/verify.mjs",
    "assemble": "node tools/assemble.mjs",
    "schedule": "node tools/schedule.mjs"
  }
}
