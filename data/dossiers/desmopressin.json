  "evidence": {
    "pk.tmaxH": "single 2 mcg dose of desmopressin acetate intravenous injection",
    "pk.halfLifeH": "The geometric mean terminal half-life is 2.8 hours",
    "pill": "DDAVP is a sterile, aqueous, colorless solution available as: 4 mcg/mL in single-dose ampule",
    "biologic": "DDAVP Injection (desmopressin acetate) is a synthetic vasopressin analog",
    "clues.kinetics": [
      "Desmopressin is not metabolized by human CYP450 system",
      "52% of the dose was recovered in the urine within 24 hours as unchanged desmopressin"
    ],
    "clues.substance": [
      "is a synthetic vasopressin analog",
      "monoacetate (salt) trihydrate",
      "molecular weight 1069.2"
    ],
    "clues.product": [
      "Application: NDA 018938",
      "4 mcg/mL in single-dose ampule 40 mcg/10 mL (4 mcg/mL) in multiple-dose vial",
      "The daily dose is 2 mcg to 4 mcg administered as one or two divided doses"
    ],
    "clues.safety": [
      "WARNING: HYPONATREMIA DDAVP can cause hyponatremia. Severe hyponatremia can be life-threatening",
      "Hyponatremia or a history of hyponatremia",
      "Known or suspected syndrome of inappropriate antidiuretic hormone (SIADH) secretion",
      "Polydipsia",
      "Digestive: Nausea, abdominal cramps"
    ],
    "clues.indication": [
      "as antidiuretic replacement therapy in the management of central (cranial) diabetes insipidus",
      "for the management of the temporary polyuria and polydipsia following head trauma or surgery in the pituitary region",
      "Hemophilia A",
      "von Willebrand's disease (Type I)"
    ],
    "clues.mechanism": [
      "stimulation of vasopressin 2 (V2) receptors, thereby increasing water re-absorption in the kidney",
      "increases plasma levels of factor VIII activity in patients with hemophilia and von Willebrand's disease Type I"
    ]
  }
