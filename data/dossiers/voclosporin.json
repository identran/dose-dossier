    "retrieved": "2026-11-21"
  },
  "evidence": {
    "pk.tmaxH": "The median T max of voclosporin is 1.5 hours (1 to 4 hours) when administered on an empty stomach",
    "pk.halfLifeH": "mean terminal half-life (t 1/2 ) is approximately 30 hours (24.9 to 36.5 hours)",
    "pill": "Capsules: 7.9 mg (voclosporin) oval, pink/orange in color",
    "biologic": "Voclosporin has an empirical formula of C 63 H 111 N 11 O 12 and a molecular weight of 1214.6 g/mole",
    "clues.kinetics": [
      "with either low- or high-fat meals, C max and AUC of voclosporin were reduced by 29% to 53% and 15% to 25%, respectively",
      "Protein binding of voclosporin is 97%",
      "Voclosporin is predominantly metabolized by CYP3A4"
    ],
    "clues.substance": [
      "Cyclo{{(6E)",
      "a molecular weight of 1214.6 g/mole",
      "It appears as white to off-white solid matter"
    ],
    "clues.product": [
      "Application: NDA 213716",
      "Capsules: 7.9 mg",
      "With a twice daily dosing regimen"
    ],
    "clues.safety": [
      "WARNING: MALIGNANCIES AND SERIOUS INFECTIONS",
      "Patients concomitantly using strong CYP3A4 inhibitors (e.g., ketoconazole, itraconazole, clarithromycin)",
      "Patients with a history of serious or severe hypersensitivity reaction, including anaphylaxis, to LUPKYNIS or any of its excipients",
      "Glomerular filtration rate decreased"
    ],
    "clues.indication": [
      "in combination with a background immunosuppressive therapy regimen for the treatment of adult patients with active lupus nephritis (LN)"
    ],
    "clues.mechanism": [
      "The mechanism of voclosporin suppression of calcineurin has not been fully established",
      "The immunosuppressant activity results in inhibition of lymphocyte proliferation, T-cell cytokine production"
