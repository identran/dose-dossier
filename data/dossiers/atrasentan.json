  "evidence": {
    "pk.tmaxH": "Atrasentan time to peak plasma concentration (T max ) is approximately 0.5 hour",
    "pk.halfLifeH": "Atrasentan effective half-life is approximately 24 to 41 hours",
    "pill": "VANRAFIA 0.75 mg: film-coated, round, biconvex, white to off-white tablet",
    "clues.kinetics": [
      "No clinically significant differences in atrasentan pharmacokinetics were observed following administration with a high-fat meal",
      "Atrasentan is > 99% bound to human plasma proteins, in vitro",
      "with approximately half via CYP3A and the remaining half via glucuronidation by multiple UGTs"
    ],
    "clues.substance": [
      "The chemical name of atrasentan hydrochloride is",
      "molecular weight 510.6"
    ],
    "clues.product": [
      "Application: NDA 219208",
      "TABLET (oral): EQ 0.75MG BASE",
      "Each bottle contains 30 tablets"
    ],
    "clues.safety": [
      "WARNING: EMBRYO-FETAL TOXICITY",
      "Use of VANRAFIA is contraindicated in patients who are pregnant",
      "VANRAFIA is contraindicated in patients with a history of a hypersensitivity reaction to atrasentan",
      "The most common adverse reactions (≥ 5%) with VANRAFIA were peripheral edema and anemia"
    ],
    "clues.indication": [
      "to reduce proteinuria in adults with primary immunoglobulin A nephropathy (IgAN) at risk of rapid disease progression"
    ],
    "clues.mechanism": [
      "Atrasentan is an ET A receptor antagonist",
      "with >1800-fold selectivity for the ET A receptor compared to the endothelin type B receptor"
