  "clues": {
    "kinetics": "It is about 94% protein bound in vitro, and fecal excretion is the main elimination route, with about 75% of radioactivity recovered within 7 days.",
    "substance": "Molecular weight 807.9 for the parent compound. It is highly lipophilic and practically insoluble in water.",
    "product": "Approved under an NDA as a one-vial injection at 20 mg/mL, in 20 mg and 80 mg single-dose vials. Given every 3 weeks.",
    "safety": "Boxed warning for toxic deaths, hepatotoxicity, neutropenia, hypersensitivity and fluid retention. Contraindicated with severe hypersensitivity to the drug or polysorbate 80; anemia and neutropenia are common.",
    "indication": "Breast cancer, as a single agent after chemotherapy failure or as adjuvant therapy with doxorubicin and cyclophosphamide; non-small cell lung cancer; and castration-resistant prostate cancer with prednisone.",
    "mechanism": "Binds free tubulin and promotes assembly into stable microtubules while inhibiting their disassembly, so mitosis is inhibited. Unlike most spindle poisons, it does not alter the number of protofilaments."
  },
  "tell": "A taxoid semisynthesized from a precursor extracted from yew needle biomass.",
  "source": {
    "setId": "45e6dce4-92e2-4ad1-bf11-bbcefb753636",
    "label": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=45e6dce4-92e2-4ad1-bf11-bbcefb753636",
    "retrieved": "2026-11-21"
  },
  "evidence": {
    "pk.tmaxH": "Administer intravenously (IV) over 1 hr every 3 weeks",
    "pk.halfLifeH": "with half-lives for the α, β, and γ phases of 4 min, 36 min, and 11.1 hr, respectively",
    "pill": "is a sterile, non-pyrogenic, pale-yellow to brownish-yellow solution at 20 mg/mL concentration",
    "clues.kinetics": [
      "docetaxel is about 94% protein bound",
      "fecal excretion was the main elimination route",
      "Within 7 days, urinary and fecal excretion accounted for approximately 6% and 75% of the administered radioactivity"
    ],
    "clues.substance": [
      "molecular weight 807.9",
      "It is highly lipophilic and practically insoluble in water"
    ],
    "clues.product": [
      "Application: NDA 020449",
      "Single-dose vials 20 mg/mL and 80 mg/4 mL",
      "Administer intravenously (IV) over 1 hr every 3 weeks"
    ],
    "clues.safety": [
      "WARNING: TOXIC DEATHS, HEPATOTOXICITY, NEUTROPENIA, HYPERSENSITIVITY REACTIONS, and FLUID RETENTION",
      "neutrophil counts of <1500 cells/mm 3",
      "a history of severe hypersensitivity reactions to docetaxel or to other drugs formulated with polysorbate 80",
      "The most common adverse reactions across all TAXOTERE indications are infections, neutropenia, anemia"
    ],
    "clues.indication": [
      "single agent for locally advanced or metastatic BC after chemotherapy failure",
      "with doxorubicin and cyclophosphamide as adjuvant treatment of operable node-positive BC",
      "single agent for locally advanced or metastatic NSCLC after platinum therapy failure",
      "with prednisone in metastatic castration-resistant prostate cancer"
    ],
    "clues.mechanism": [
      "Docetaxel binds to free tubulin and promotes the assembly of tubulin into stable microtubules while simultaneously inhibiting their disassembly",
      "Docetaxel's binding to microtubules does not alter the number of protofilaments in the bound microtubules, a feature which differs from most spindle poisons currently in clinical use",
      "which results in the inhibition of mitosis in cells"
    ]
  }
